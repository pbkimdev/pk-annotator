{
  "name": "@srv/pk-annotator",
  "version": "0.1.0",
  "description": "Dev-only browser annotation overlay, Vite plugin, pka CLI, and pka-mcp stdio server",
  "license": "UNLICENSED",
  "bin": {
    "pka": "./dist/pka.mjs",
    "pka-mcp": "./dist/pka-mcp.mjs"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    "./vite": {
      "types": "./dist/vite.d.mts",
      "default": "./dist/vite.mjs"
    },
    "./overlay": {
      "types": "./dist/overlay.d.mts",
      "default": "./dist/overlay.mjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "registry": "https://git.paulbkim.dev/api/packages/srv/npm/"
  },
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "lint": "oxlint .",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "typecheck": "tsc --noEmit && tsc --noEmit -p fixtures/app",
    "fixture": "pnpm build && pnpm --filter @srv/pk-annotator-fixture dev",
    "verify": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test && pnpm build"
  },
  "dependencies": {
    "@jridgewell/trace-mapping": "0.3.31",
    "@modelcontextprotocol/server": "2.2.0",
    "magic-string": "1.4.2",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.2.0",
    "@oxlint/plugins": "1.78.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@zumer/snapdom": "3.2.0",
    "ai": "7.0.127",
    "bippy": "0.7.3",
    "class-variance-authority": "0.7.1",
    "cmdk": "1.1.1",
    "cn": "0.4.0",
    "happy-dom": "20.14.5",
    "lucide-react": "1.49.0",
    "nanoid": "6.0.1",
    "oxfmt": "0.71.0",
    "oxlint": "1.78.0",
    "postcss": "8.5.28",
    "radix-ui": "1.6.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "shadcn": "4.21.1",
    "tailwindcss": "4.3.3",
    "tsdown": "0.23.0",
    "tw-animate-css": "1.4.0",
    "typescript": "7.0.2",
    "vite": "8.3.2",
    "vitest": "5.0.3"
  },
  "peerDependencies": {
    "react": "^19",
    "react-dom": "^19",
    "vite": "^8"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "vite": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.19.0"
}
